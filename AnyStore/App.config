<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
    </startup>

  <connectionStrings>
    <!-- Cloud-ready connection string: Uses environment variable DB_CONNECTION_STRING -->
    <!-- Format: Data Source={RDS_HOSTNAME};Initial Catalog={DB_NAME};User Id={DB_USERNAME};Password={DB_PASSWORD};Connect Timeout=30;Encrypt=True;TrustServerCertificate=False -->
    <add name="connstrng" connectionString=""/>
  </connectionStrings>
  <appSettings>
    <!-- Cloud configuration settings - Override via environment variables -->
    <add key="DB_CONNECTION_STRING" value=""/>
    <add key="AWS_REGION" value="us-east-1"/>
    <add key="LOG_LEVEL" value="Information"/>
    <add key="USE_CONSOLE_LOGGING" value="true"/>
  </appSettings>
</configuration>